# providers.toml — declarative multi-provider configuration for llmproxy.
#
# Point llmproxy at this file via PROVIDERS_CONFIG (default: providers.toml).
# When no such file exists, a single provider is synthesized from the NVIDIA_*
# env vars instead (zero-config, backward compatible). You can generate a filled
# starting point from your current environment with:
#
#     make migrate-config          # -> providers.toml
#
# Naming: every provider's models are exposed together (the union). With a single
# provider the exposed names stay bare (e.g. meta/llama-3.1-8b-instruct); with two
# or more they become "<provider>:<model>" (the ':' leaves the '/' in ids intact)
# to disambiguate. A per-model `alias` overrides the exposed name in either case.
# Clients may also send the bare model id.
#
# Secrets: use "${ENV_VAR}" references (expanded from the environment) so this
# file stays safe to commit.
#
# base_url is shown explicitly for every provider below. For the typed providers
# (openai, mistral, anthropic, gemini) it can be omitted to fall back to the
# default shown here; for `openai_compatible` and `azure` it is required.

# ── NVIDIA ───────────────────────────────────────────────────────────────────
[[provider]]
name = "nvidia"
type = "openai_compatible"
base_url = "https://integrate.api.nvidia.com/v1"
api_key = "${NVIDIA_API_KEY}"
models = ["meta/llama-3.1-8b-instruct", "meta/llama-3.1-70b-instruct"]
embeddings_models = ["nvidia/nv-embedqa-e5-v5"]

# ── OpenAI ───────────────────────────────────────────────────────────────────
# [[provider]]
# name = "openai"
# type = "openai"
# base_url = "https://api.openai.com/v1"
# api_key = "${OPENAI_API_KEY}"
# models = ["gpt-4o", "gpt-4o-mini"]
# embeddings_models = ["text-embedding-3-small"]

# ── Anthropic (Claude) — native Messages API translation ─────────────────────
# [[provider]]
# name = "anthropic"
# type = "anthropic"
# base_url = "https://api.anthropic.com"
# api_key = "${ANTHROPIC_API_KEY}"
# max_tokens = 4096               # Anthropic requires a max_tokens (this is the default)
# models = ["claude-opus-4-8", "claude-sonnet-5"]

# ── Google Gemini — native generateContent translation ───────────────────────
# [[provider]]
# name = "gemini"
# type = "gemini"
# base_url = "https://generativelanguage.googleapis.com/v1beta"
# api_key = "${GEMINI_API_KEY}"
# models = ["gemini-2.5-pro", "gemini-2.5-flash"]

# ── Azure OpenAI — model id == deployment name ───────────────────────────────
# [[provider]]
# name = "azure"
# type = "azure"
# base_url = "https://YOUR-RESOURCE.openai.azure.com"
# api_key = "${AZURE_OPENAI_API_KEY}"
# api_version = "2024-02-01"
# models = ["gpt-4o"]

