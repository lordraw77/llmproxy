PORT=11434
HOST=0.0.0.0

# Logging / telemetria
# LOG_LEVEL: DEBUG mostra anche il payload inviato a NVIDIA. Default INFO.
LOG_LEVEL=DEBUG
# Timezone dell'orologio nei log (nome IANA, es. Europe/Rome). Default UTC.
LOG_TZ=Europe/Rome

NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Read timeout (secondi) verso l'upstream. Le richieste non-streaming non
# ricevono alcun byte finche' la risposta non e' completa: modelli lenti
# (reasoning/grandi/in coda) possono superare il default di 120. Default 120.
UPSTREAM_TIMEOUT=120

# Forza lo streaming verso l'upstream su /chat/completions anche quando il
# chiamante chiede stream=false. L'upstream invia byte SSE in continuazione,
# quindi il read-timeout non scatta mai; il proxy ri-aggrega i chunk e
# restituisce comunque una singola risposta JSON. Comportamento verso il
# chiamante invariato. Valori validi: 1/true/yes/on. Default false.
#FORCE_UPSTREAM_STREAM=on

# Proxy HTTP uscente verso l'upstream (proxy aziendale / egress). Necessario se
# il server raggiunge Internet solo tramite proxy: senza queste variabili il
# container va diretto e le richieste a NVIDIA restano appese finche' non scatta
# UPSTREAM_TIMEOUT. env_file le passa al container, e sia requests sia il proxy
# le usano. NO_PROXY esclude host interni/localhost dal proxy.
#HTTP_PROXY=http://ep.threatpulse.net:80
#HTTPS_PROXY=http://ep.threatpulse.net:80
#NO_PROXY=localhost,127.0.0.1,.hcltechlab.com,.ctg.labs,.hpelab.local,10.10.0.0/21,192.168.0.0/21

# Retry sugli errori transitori dell'upstream (429 / 5xx / errori di rete).
# RETRY_MAX: numero di ritentativi oltre al primo (0 = disabilitato). Default 2.
# RETRY_BACKOFF: base del backoff esponenziale in secondi (rispetta Retry-After se presente). Default 0.5.
RETRY_MAX=2
RETRY_BACKOFF=0.5

# Autenticazione in ingresso (opzionale). Se impostata, ogni richiesta deve
# presentare questa chiave via "Authorization: Bearer <key>" o "X-Api-Key: <key>".
# I percorsi "/" e "/health" restano sempre accessibili (per gli health-check).
# Lasciala vuota/commentata per mantenere il proxy aperto.
#PROXY_API_KEY=cambia-questa-chiave

# Embeddings (endpoint /v1/embeddings, /api/embeddings, /api/embed).
# Modello usato quando il client non ne specifica uno (i modelli di chat non sono validi).
NVIDIA_EMBEDDINGS_MODEL=nvidia/nv-embedqa-e5-v5
# input_type applicato se il client non lo fornisce ("query" o "passage"). Vuoto per non forzarlo.
EMBEDDINGS_INPUT_TYPE=query

# Modello singolo (retro-compatibile). Usato come default se NVIDIA_MODELS non e' impostato.
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Multi-modello: elenco separato da virgole. Il primo e' il default.
# Tutti i modelli elencati compaiono in Open WebUI (/api/tags e /v1/models).
#NVIDIA_MODELS=meta/llama-3.1-8b-instruct,meta/llama-3.1-70b-instruct,mistralai/mistral-7b-instruct-v0.3
NVIDIA_MODELS=meta/llama-3.2-1b-instruct,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,nvidia/nemotron-3-nano-30b-a3b,mistralai/mistral-small-4-119b-2603,mistralai/mistral-large-3-675b-instruct-2512,nvidia/nemotron-mini-4b-instruct,nvidia/nemotron-3-content-safety,nvidia/nemotron-content-safety-reasoning-4b,nvidia/nemotron-3.5-content-safety,nvidia/riva-translate-4b-instruct-v1.1,meta/llama-3.1-8b-instruct,nvidia/nemotron-3-ultra-550b-a55b,nvidia/llama-3.1-nemotron-nano-vl-8b-v1,microsoft/phi-4-mini-instruct,upstage/solar-10.7b-instruct,sarvamai/sarvam-m,stockmark/stockmark-2-100b-instruct,nvidia/nemotron-nano-12b-v2-vl,abacusai/dracarys-llama-3.1-70b-instruct,meta/llama-3.2-11b-vision-instruct,google/gemma-3n-e4b-it,mistralai/ministral-14b-instruct-2512,meta/llama-3.2-90b-vision-instruct,mistralai/mixtral-8x7b-instruct-v0.1,nvidia/llama-3.3-nemotron-super-49b-v1
